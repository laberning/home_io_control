---
# ESPHome clang-tidy configuration
# Source: https://github.com/esphome/esphome/blob/dev/.clang-tidy
# Format: list with inline comments explaining exclusions
Checks:
  - "*"  # Enable all checks by default, then subtract

  # --- Platform / Library Exclusions (not applicable) ---
  - -abseil-*  # Not using Abseil
  - -altera-*  # FPGA-specific, not applicable
  - -android-*  # Android-specific APIs not used
  - -boost-*  # Not using Boost
  - -fuchsia-*  # Fuchsia OS-specific, not applicable to ESP32
  - -mpi-*  # MPI parallel programming not relevant
  - -objc-*  # Objective-C not used
  - -concurrency-*  # Single-threaded event loop; no threads

  # --- Bugprone ---
  - -bugprone-derived-method-shadowing-base-method
  - -bugprone-easily-swappable-parameters
  - -bugprone-implicit-widening-of-multiplication-result
  - -bugprone-invalid-enum-default-initialization
  - -bugprone-multi-level-implicit-pointer-conversion
  - -bugprone-narrowing-conversions
  - -bugprone-tagged-union-member-count
  - -bugprone-signed-char-misuse

  # --- CERT (secure coding) - Mirroring exclusions used by ESPHome ---
  - -cert-dcl50-cpp
  - -cert-err33-c
  - -cert-err58-cpp
  - -cert-int09-c
  - -cert-oop57-cpp
  - -cert-str34-c

  # --- Clang analyzer options - Mirroring exclusions used by ESPHome ---
  - -clang-analyzer-optin.core.EnumCastOutOfRange
  - -clang-analyzer-optin.cplusplus.UninitializedObject
  - -clang-analyzer-osx.*
  - -clang-analyzer-security.ArrayBound

  # --- Diagnostic flags ---
  - -clang-diagnostic-delete-abstract-non-virtual-dtor
  - -clang-diagnostic-delete-non-abstract-non-virtual-dtor
  - -clang-diagnostic-deprecated-declarations
  - -clang-diagnostic-ignored-optimization-argument
  - -clang-diagnostic-missing-designated-field-initializers
  - -clang-diagnostic-missing-field-initializers
  - -clang-diagnostic-shadow-field
  - -clang-diagnostic-unused-const-variable
  - -clang-diagnostic-unused-parameter
  - -clang-diagnostic-vla-cxx-extension

  # --- C++ Core Guidelines: Avoid-* (embedded exceptions) ---
  - -cppcoreguidelines-avoid-c-arrays  # C arrays required for hardware buffers, protocol frames; no STL in freestanding
  - -cppcoreguidelines-avoid-const-or-ref-data-members  # Pointer members required for ESPHome component model
  - -cppcoreguidelines-avoid-do-while
  - -cppcoreguidelines-avoid-magic-numbers # todo: would be nice to enable but needs refactoring
  - -cppcoreguidelines-init-variables
  - -cppcoreguidelines-macro-to-enum  # Macros used for protocol constants that must be usable in preprocessor expressions and as array sizes
  - -cppcoreguidelines-macro-usage  # Macros are idiomatic in this low-level codebase
  - -cppcoreguidelines-missing-std-forward
  - -cppcoreguidelines-narrowing-conversions  # Explicit casts common in bit manipulation
  - -cppcoreguidelines-non-private-member-variables-in-classes
  - -cppcoreguidelines-owning-memory
  - -cppcoreguidelines-prefer-member-initializer

  # --- C++ Core Guidelines: Pro-Bounds-* (low-level pointer/bounds checks) ---
  - -cppcoreguidelines-pro-bounds-array-to-pointer-decay  # Array decay used for buffer APIs
  - -cppcoreguidelines-pro-bounds-avoid-unchecked-container-access
  - -cppcoreguidelines-pro-bounds-constant-array-index
  - -cppcoreguidelines-pro-bounds-pointer-arithmetic  # Needed for hardware register arithmetic

   # --- C++ Core Guidelines: Pro-Type-* (enabled: const-cast, reinterpret-cast, static-cast-downcast) ---
  - -cppcoreguidelines-pro-type-cstyle-cast  # C-style casts retained for bit manipulation and hardware access; idiomatic in embedded
  - -cppcoreguidelines-pro-type-member-init
  - -cppcoreguidelines-pro-type-union-access  # Unions used for hardware register overlays
  - -cppcoreguidelines-pro-type-vararg
  - -cppcoreguidelines-rvalue-reference-param-not-moved
  - -cppcoreguidelines-special-member-functions
  - -cppcoreguidelines-use-default-member-init
  - -cppcoreguidelines-use-enum-class
  - -cppcoreguidelines-virtual-class-destructor

  # --- Google style (conflict with project's embedded style) ---
  - -google-build-using-namespace
  - -google-explicit-constructor
  - -google-readability-braces-around-statements
  - -google-readability-casting
  - -google-readability-namespace-comments
  - -google-readability-todo
  - -google-runtime-references

  # --- LLVM style (different conventions) ---
  - -hicpp-*  # HiCPP stricter than standard cppcoreguidelines
  - -llvm-else-after-return
  - -llvm-header-guard
  - -llvm-include-order
  - -llvm-prefer-static-over-anonymous-namespace
  - -llvm-qualified-auto
  - -llvm-use-ranges
  - -llvmlibc-*

  # --- Misc (project-specific decisions) ---
  - -misc-const-correctness  # todo: might be nice to enable, but currently lots of conflicts
  - -misc-include-cleaner  # Include management differs in PlatformIO/ESPHome environment
  - -misc-multiple-inheritance
  - -misc-no-recursion
  - -misc-non-private-member-variables-in-classes
  - -misc-override-with-different-visibility
  - -misc-unused-parameters  # Callback interfaces often have unused parameters (e.g., update callbacks)
  - -misc-use-anonymous-namespace
  - -misc-use-internal-linkage

  # --- Modernize: C++20 / STL / style changes (mostly not applicable to embedded C++17) ---
  - -modernize-avoid-bind  # Not applicable: code uses lambdas, no std::bind
  - -modernize-avoid-variadic-functions  # Not applicable: no variadic templates/functions used
  - -modernize-avoid-c-arrays  # Embedded: C arrays required for hardware buffers; no STL
  - -modernize-avoid-c-style-cast  # Embedded: C-style casts idiomatic for bit/register ops
  - -modernize-concat-nested-namespaces  # Not applicable: namespace structure is flat (esphome::home_io_control)
  - -modernize-macro-to-enum  # Protocol constants need preprocessor-use and array-size semantics
  - -modernize-return-braced-init-list
  - -modernize-type-traits  # Not applicable: no heavy type-trait metaprogramming in use
  - -modernize-use-constraints  # C++20 concepts; toolchain is C++17
  - -modernize-use-default-member-init
  - -modernize-use-designated-initializers  # C++20 feature unavailable in C++17
  - -modernize-use-integer-sign-comparison  # todo: maybe enable
  - -modernize-use-ranges  # C++20 ranges + STL algorithms not used
  - -modernize-use-trailing-return-type

  # --- Portability (not relevant for single-target embedded) ---
  - -portability-avoid-pragma-once
  - -portability-template-virtual-member-function

  # --- Readability ---
  - -readability-container-contains  # Not applicable: std::map::contains() is C++20; our toolchain is C++17
  - -readability-container-data-pointer  # Not applicable: no STL container data() pointer access patterns used
  - -readability-function-cognitive-complexity  # todo: would be nice to enable but needs refactoring
  - -readability-magic-numbers  # todo: would be nice to enable but needs refactoring

WarningsAsErrors: '*'
FormatStyle:     google
CheckOptions:
  - key: google-readability-function-size.StatementThreshold
    value: '800'
  - key: google-runtime-int.TypeSuffix
    value: '_t'
  - key: llvm-namespace-comment.ShortNamespaceLines
    value: '10'
  - key: llvm-namespace-comment.SpacesBeforeComments
    value: '2'
  - key: modernize-loop-convert.MaxCopySize
    value: '16'
  - key: modernize-loop-convert.MinConfidence
    value: reasonable
  - key: modernize-loop-convert.NamingStyle
    value: CamelCase
  - key: modernize-pass-by-value.IncludeStyle
    value: llvm
  - key: modernize-replace-auto-ptr.IncludeStyle
    value: llvm
  - key: modernize-use-nullptr.NullMacros
    value: 'NULL'
  - key: modernize-make-unique.MakeSmartPtrFunction
    value: 'make_unique'
  - key: modernize-make-unique.MakeSmartPtrFunctionHeader
    value: 'esphome/core/helpers.h'
  - key: readability-braces-around-statements.ShortStatementLines
    value: 2
  - key: readability-identifier-naming.LocalVariableCase
    value: 'lower_case'
  - key: readability-identifier-naming.ClassCase
    value: 'CamelCase'
  - key: readability-identifier-naming.StructCase
    value: 'CamelCase'
  - key: readability-identifier-naming.EnumCase
    value: 'CamelCase'
  - key: readability-identifier-naming.EnumConstantCase
    value: 'UPPER_CASE'
  - key: readability-identifier-naming.StaticConstantCase
    value: 'UPPER_CASE'
  - key: readability-identifier-naming.StaticVariableCase
    value: 'lower_case'
  - key: readability-identifier-naming.GlobalConstantCase
    value: 'UPPER_CASE'
  - key: readability-identifier-naming.ParameterCase
    value: 'lower_case'
  - key: readability-identifier-naming.PrivateMemberCase
    value: 'lower_case'
  - key: readability-identifier-naming.PrivateMemberSuffix
    value: '_'
  - key: readability-identifier-naming.PrivateMethodCase
    value: 'lower_case'
  - key: readability-identifier-naming.PrivateMethodSuffix
    value: '_'
  - key: readability-identifier-naming.ClassMemberCase
    value: 'lower_case'
  - key: readability-identifier-naming.ClassMemberCase
    value: 'lower_case'
  - key: readability-identifier-naming.ProtectedMemberCase
    value: 'lower_case'
  - key: readability-identifier-naming.ProtectedMemberSuffix
    value: '_'
  - key: readability-identifier-naming.FunctionCase
    value: 'lower_case'
  - key: readability-identifier-naming.ClassMethodCase
    value: 'lower_case'
  - key: readability-identifier-naming.ProtectedMethodCase
    value: 'lower_case'
  - key: readability-identifier-naming.ProtectedMethodSuffix
    value: '_'
  - key: readability-identifier-naming.VirtualMethodCase
    value: 'lower_case'
  - key: readability-identifier-naming.VirtualMethodSuffix
    value: ''
  - key: readability-qualified-auto.AddConstToQualified
    value: 0
  - key: readability-identifier-length.MinimumVariableNameLength
    value: 0
  - key: readability-identifier-length.MinimumParameterNameLength
    value: 0
  - key: readability-identifier-length.MinimumLoopCounterNameLength
    value: 0

  - key: readability-identifier-length.MinimumVariableNameLength
    value: 0
  - key: readability-identifier-length.MinimumParameterNameLength
    value: 0
  - key: readability-identifier-length.MinimumLoopCounterNameLength
    value: 0
