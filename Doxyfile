# Doxyfile 1.14 — Home IO Control
# Run `make doxygen` to generate HTML docs.
# YAML fenced code blocks in Markdown are pre-processed by scripts/pygmentize-md-yaml.py
# (run before doxygen) to produce Pygments HTML with syntax highlighting.

PROJECT_NAME           = "Home IO Control"
PROJECT_BRIEF          = "ESPHome add-on for IO-Homecontrol devices"
OUTPUT_DIRECTORY       = docs/doxygen
INPUT                  = components/home_io_control/ \
                          build/docs/README.md \
                          build/docs/home_io_control.md \
                          LICENSE
USE_MDFILE_AS_MAINPAGE = build/docs/README.md
RECURSIVE              = YES
FILE_PATTERNS          = *.h *.cpp

# Parse /// and /** */ comments (Javadoc style)
JAVADOC_AUTOBRIEF      = YES
BRIEF_MEMBER_DESC      = YES
REPEAT_BRIEF           = YES
ALWAYS_DETAILED_SEC    = NO
INLINE_SOURCES         = NO
STRIP_CODE_COMMENTS    = NO
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = YES
CASE_SENSE_NAMES       = YES
SORT_MEMBER_DOCS       = YES
SORT_BRIEF_DOCS        = NO

# Output: HTML only (no LaTeX/PDF)
GENERATE_HTML           = YES
GENERATE_LATEX          = NO

# Use treeview sidebar for easier navigation
GENERATE_TREEVIEW       = YES
DISABLE_INDEX           = NO
FULL_SIDEBAR            = NO

# Source browser: show line-numbered source in docs
SOURCE_BROWSER          = YES
REFERENCES_LINK_SOURCE  = YES

# Modern stylesheet: doxygen-awesome-css (sidebar-only variant)
HTML_COLORSTYLE         = LIGHT
HTML_EXTRA_STYLESHEET   = build/doxygen-resources/doxygen-awesome.css \
                          build/doxygen-resources/doxygen-awesome-sidebar-only.css \
                          build/doxygen-resources/doxygen-awesome-sidebar-only-darkmode-toggle.css \
                          doxygen-custom/custom.css

HTML_EXTRA_FILES        = build/doxygen-resources/doxygen-awesome-darkmode-toggle.js \
                          build/doxygen-resources/doxygen-awesome-fragment-copy-button.js \
                          build/doxygen-resources/doxygen-awesome-paragraph-link.js \
                          build/doxygen-resources/doxygen-awesome-interactive-toc.js \
                          build/doxygen-resources/doxygen-awesome-tabs.js

HTML_HEADER              = doxygen-custom/header.html

# Graphviz call graphs
HAVE_DOT                = YES
DOT_NUM_THREADS         = 0
DOT_IMAGE_FORMAT        = svg
INTERACTIVE_SVG         = YES
DOT_GRAPH_MAX_NODES     = 50
MAX_DOT_GRAPH_DEPTH     = 3
UML_LOOK                = YES
TEMPLATE_RELATIONS      = YES
CALL_GRAPH              = YES
CALLER_GRAPH            = NO
TREEVIEW_WIDTH          = 335

# Color tuning recommended by doxygen-awesome docs
HTML_COLORSTYLE_HUE     = 209
HTML_COLORSTYLE_SAT     = 255
HTML_COLORSTYLE_GAMMA   = 113

# IDE integration: ctags-compatible tag file
GENERATE_TAGFILE         = docs/doxygen/io-homecontrol.tag

# Allow \if doxygen / \if NOT doxygen conditional blocks in markdown docs
# When this tag matches, \if doxygen content is shown and \if NOT doxygen is hidden
ENABLED_SECTIONS         = doxygen

# Quiet mode (suppress most progress output)
QUIET                   = YES
WARNINGS                = YES
WARN_IF_UNDOCUMENTED    = YES
WARN_IF_DOC_ERROR       = YES