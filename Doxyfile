# Doxyfile — Home IO Control  (doxygen version is pinned in scripts/generate-doxygen.sh, not here)
# Run `make doxygen` to generate HTML docs.
# Markdown under INPUT (build/docs/*) is produced by scripts/stage-docs.py, which turns committed
# GitHub-flavoured Markdown into doxygen-flavoured Markdown (YAML highlighting, {#page-labels},
# \subpage trees). No doxygen-only syntax is ever committed to a source .md file.

PROJECT_NAME           = "Home IO Control"
PROJECT_BRIEF          = "ESPHome add-on for IO-Homecontrol devices"
OUTPUT_DIRECTORY       = docs/doxygen
INPUT                  = components/home_io_control/ \
                          build/docs/
USE_MDFILE_AS_MAINPAGE = build/docs/README.md
RECURSIVE              = YES
# The whole staging root is INPUT, not a per-page list: scripts/stage-docs.py wipes build/docs/ on
# every run, so nothing stale can be picked up, and adding a page costs no Doxyfile edit. *.md is
# what makes RECURSIVE pick the staged pages up.
#
# Cost of the directory form: check A in scripts/check-docs-links.py can no longer prove "every
# staged page is reachable from INPUT" (it is, vacuously). Check E covers the real risk instead --
# it requires every staged page to be named in exactly one <!-- doxygen-subpages --> block, so a
# page that is written but never parented fails the build.
#
# Known artefact: doxygen 1.18 emits a stub "File Reference" page per Markdown input
# (`*_8md.html`, empty body). LAYOUT_FILE hides them from the sidebar and
# AUTOLINK_IGNORE_WORDS keeps prose from linking them, but they still appear in the file
# search index. Accepted -- there is no doxygen option to suppress them without also
# dropping the real `{#label}` pages.
FILE_PATTERNS          = *.h *.cpp *.py *.md
EXTENSION_MAPPING      = py=Python
# build/docs/adr/README.md is a real page ({#adr_index}, staged from docs/adr/README.md), not
# the "documentation of the adr/ directory" -- without this, doxygen would swallow it as a dir
# doc and its {#label}/\subpage list would not take effect.
IMPLICIT_DIR_DOCS      = NO

# Heading anchors use GitHub's slug algorithm, so `[x](doc.md#some-heading)` resolves identically
# on github.com, on the generated site, and in scripts/check-docs-links.py. Must stay in place
# before any doc file is moved -- it is what makes cross-document #anchor links survive a move.
MARKDOWN_ID_STYLE      = GITHUB

# `home_io_control` is both the C++ namespace and the ESPHome YAML key, and `esphome` is a
# namespace too. Without this, every mention of the YAML key in the user guide autolinks to the
# namespace reference page (57 occurrences in docs/home_io_control.md alone). Real class names
# like ExchangeEngine still autolink.
#
# The `*.md` entries: doxygen 1.18 emits a (stub) file page for every Markdown INPUT and
# autolinks a bare filename to it -- including inside inline code spans -- so a prose mention of
# "docs/home_io_control.md" would land on an empty `home__io__control_8md.html` whose title
# leaks `build/docs/...`. The ignore word must be the exact token as it appears in prose, path
# prefix included. scripts/check-doxygen-output-links.py fails the build if a new one slips in.
AUTOLINK_IGNORE_WORDS  = home_io_control esphome \
                        architecture_overview.md \
                        docs/home_io_control.md \
                        docs/configuration/tuning.md \
                        docs/configuration/oneway-transmit.md \
                        docs/configuration/climate.md \
                        docs/configuration/cover.md \
                        docs/diagnostic-probes.md \
                        diagnostic-entities.md \
                        docs/key-extraction.md \
                        docs/lr1121-firmware.md \
                        docs/pairing.md \
                        docs/troubleshooting.md \
                        docs/adr/0013-blocking-exchange-on-the-esphome-loop.md

# Parse /// and /** */ comments (Javadoc style)
JAVADOC_AUTOBRIEF      = YES
BRIEF_MEMBER_DESC      = YES
REPEAT_BRIEF           = YES
ALWAYS_DETAILED_SEC    = NO
INLINE_SOURCES         = NO
STRIP_CODE_COMMENTS    = NO
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = YES
CASE_SENSE_NAMES       = YES
SORT_MEMBER_DOCS       = YES
SORT_BRIEF_DOCS        = NO
SUBGROUPING            = YES
PYTHON_DOCSTRING       = YES

# Output: HTML only (no LaTeX/PDF)
GENERATE_HTML           = YES
GENERATE_LATEX          = NO
GENERATE_TODOLIST       = YES
GENERATE_BUGLIST        = YES

# Use treeview sidebar for easier navigation
GENERATE_TREEVIEW       = YES
DISABLE_INDEX           = NO
FULL_SIDEBAR            = NO
HTML_DYNAMIC_SECTIONS   = YES
# Only affects auto-generated [TOC] blocks, which no doc in this repo uses -- inert here, kept
# at the default so the sidebar heading depth is not a surprise if a [TOC] is ever added.
TOC_INCLUDE_HEADINGS    = 4

# Source browser: show line-numbered source in docs
SOURCE_BROWSER          = YES
REFERENCES_LINK_SOURCE  = YES

# Modern stylesheet: doxygen-awesome-css (sidebar-only variant)
HTML_COLORSTYLE         = LIGHT
HTML_EXTRA_STYLESHEET   = build/doxygen-resources/doxygen-awesome.css \
                          build/doxygen-resources/doxygen-awesome-sidebar-only.css \
                          build/doxygen-resources/doxygen-awesome-sidebar-only-darkmode-toggle.css \
                          doxygen-custom/custom.css

# jquery-shim.js: doxygen dropped jQuery in 1.17; doxygen-awesome-css v2.4.2 still calls `$` in
# three scripts, so we ship a ~1 KB vanilla stand-in instead of vendoring jQuery.
# mermaid-lazy.mjs / mermaid.min.js: see the MERMAID_* notes below -- the shim is loaded on
# every page, the ~3.5 MB bundle only where a diagram is.
HTML_EXTRA_FILES        = build/doxygen-resources/doxygen-awesome-darkmode-toggle.js \
                          build/doxygen-resources/doxygen-awesome-fragment-copy-button.js \
                          build/doxygen-resources/doxygen-awesome-paragraph-link.js \
                          build/doxygen-resources/doxygen-awesome-interactive-toc.js \
                          build/doxygen-resources/doxygen-awesome-tabs.js \
                          build/doxygen-resources/mermaid.min.js \
                          doxygen-custom/jquery-shim.js \
                          doxygen-custom/mermaid-lazy.mjs \
                          doxygen-custom/mobile-nav.js

HTML_HEADER              = doxygen-custom/header.html

# Sidebar layout: Overview / Documentation / API Reference (three usergroup wrappers around the
# built-in tabs), with the raw doxygen taxonomy (Namespaces, Structs, ...) hidden. Regenerate
# the template with `doxygen -l` and re-apply the <navindex> edits on every doxygen upgrade.
LAYOUT_FILE              = doxygen-custom/DoxygenLayout.xml

# doxygen >= 1.17 has a built-in fragment copy button (clipboard.js). doxygen-awesome-css v2.4.2
# still ships its own (doxygen-awesome-fragment-copy-button.js, wired in header.html), which the
# theme CSS is styled for -- keep that one and turn the native one off so fragments don't get
# two copy buttons.
HTML_COPY_CLIPBOARD      = NO

# Mermaid: CLIENT_SIDE makes doxygen emit <pre class="mermaid"> for ```mermaid fences, plus a
# per-page `import mermaid from '<MERMAID_JS_URL>'; mermaid.initialize(...)` block (it injects
# this even when $mermaidjs is absent from the header). MERMAID_JS_URL points at our own shim,
# mermaid-lazy.mjs: it absorbs the initialize() call everywhere and only fetches the real
# ~3.5 MB mermaid.min.js on pages that actually contain a diagram. No CDN.
MERMAID_RENDER_MODE     = CLIENT_SIDE
MERMAID_JS_URL          = ./mermaid-lazy.mjs

# Graphviz call graphs
HAVE_DOT                = YES
DOT_NUM_THREADS         = 0
DOT_IMAGE_FORMAT        = svg
INTERACTIVE_SVG         = YES
DOT_GRAPH_MAX_NODES     = 50
MAX_DOT_GRAPH_DEPTH     = 3
UML_LOOK                = YES
TEMPLATE_RELATIONS      = YES
CALL_GRAPH              = YES
CALLER_GRAPH            = NO
TREEVIEW_WIDTH          = 335

# Color tuning recommended by doxygen-awesome docs
HTML_COLORSTYLE_HUE     = 209
HTML_COLORSTYLE_SAT     = 255
HTML_COLORSTYLE_GAMMA   = 113

# IDE integration: ctags-compatible tag file
GENERATE_TAGFILE         = docs/doxygen/io-homecontrol.tag

# Latent escape hatch only. `\if doxygen` twin blocks were evaluated and rejected in
# docs/adr/0034 (they leave `\if`/`\endif` as literal text on github.com); the committed docs
# use none. Kept set so the mechanism is available without a Doxyfile change if it is ever needed.
ENABLED_SECTIONS         = doxygen

# Quiet mode (suppress most progress output)
QUIET                   = YES
WARNINGS                = YES
WARN_IF_UNDOCUMENTED    = YES
WARN_IF_DOC_ERROR       = YES

# Documentation errors (bad \ref, unresolvable links) fail the build so a broken doc cannot ship.
# EXTRACT_ALL = YES suppresses the undocumented-member warnings, so this fires on real doc errors
# only. FAIL_ON_WARNINGS (not YES) completes the whole run first, then exits non-zero.
WARN_AS_ERROR           = FAIL_ON_WARNINGS
# Collect warnings in a file so CI can surface them; note unsupported-config-tag warnings still go
# to stderr and bypass this log (see the "Show doxygen warnings" step keeps make output visible).
WARN_LOGFILE            = build/doxygen-warnings.log
